{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "theme": "dark-ansi",
  "autoCompactEnabled": false,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-summarize.sh",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ]
  }
}
