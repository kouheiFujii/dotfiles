// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",

    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "tab": "vim::Indent"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "<": "vim::Outdent"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-r": "project_panel::Rename"
    }
  }
]
